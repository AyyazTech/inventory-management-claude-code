// Prisma schema for the inventory management system.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  sku             String   @unique
  category        String // SQLite has no native enum; allowed values are constrained at the app layer (see src/lib/format.ts CATEGORIES + zod).
  quantityInStock Int      @default(0)
  unitPriceCents  Int // Money stored as integer cents — serializable across the Server/Client boundary and free of float drift.
  reorderLevel    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movements StockMovement[]

  @@index([category])
}

// An immutable audit-log entry for every stock change. `resultingQuantity` is
// the product's quantity *after* the movement, captured at write time so the
// log reads correctly without recomputation. Deleting a product cascades to
// its movements.
model StockMovement {
  id                Int      @id @default(autoincrement())
  productId         Int
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type              String // "IN" | "OUT" (SQLite has no enum; constrained via zod)
  amount            Int // positive quantity moved
  resultingQuantity Int // product quantity after this movement
  createdAt         DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// Minimal auth: a single demo user. No roles, signup, or password reset.
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
